        "_id": "69dcfa1f533b7c23b2a1a2a5",
        "questionText": "A savings account earns 12% p.a. compound interest. ₦500,000 is deposited. What is the balance after 2 years?",
        "options": {
          "A": "₦620,000",
          "B": "₦627,200",
          "C": "₦560,000",
          "D": "₦614,400"
