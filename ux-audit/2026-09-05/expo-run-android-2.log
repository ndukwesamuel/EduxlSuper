        "tags": [
          "currency calculations"
        ],
        "difficulty": "medium"
      },
      {
        "_id": "69dcfa1f533b7c23b2a1a2a6",
        "questionText": "A trader buys goods for ₦180,000 and sells for ₦225,000. What is the profit margin?",
        "options": {
          "A": "20%",
          "B": "25%",
          "C": "22.5%",
          "D": "28%"
        },
        "correctAnswer": "B",
        "explanation": "Profit = ₦45,000. Margin = (45,000 / 180,000) × 100 = 25%.",
        "category": "numerical",
        "tags": [
          "profit & loss"
        ],
        "difficulty": "easy"
      },
      {
        "_id": "69dcfa99a527689926919005",
        "questionText": "A merchant buys goods for ₦450,000. His overheads are 10% of cost price. He sells for ₦550,000. What is his net profit?",
        "options": {
          "A": "₦45,000",
          "B": "₦55,000",
          "C": "₦60,000",
          "D": "₦65,000"
        },
        "correctAnswer": "B",
        "explanation": "Overheads = 10% of 450,000 = ₦45,000. Total cost = 495,000. Profit = 550,000 - 495,000 = ₦55,000.",
        "category": "numerical",
        "tags": [
          "profit & loss"
        ],
        "difficulty": "medium"
      },
      {
        "_id": "69dcfa99a527689926919017",
        "questionText": "Adaeze can process 150 loan applications in 5 days. Emeka can process the same number in 6 days. Working together, how many days will it take?",
