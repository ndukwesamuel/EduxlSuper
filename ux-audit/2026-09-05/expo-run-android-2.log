          "compound interest"
        ],
        "difficulty": "medium"
      },
      {
        "_id": "69dcfa99a52768992691903e",
        "questionText": "A bank's domiciliary account holder deposits $5,000 when rate is ₦1,550/$. She withdraws when rate is ₦1,700/$. What is her naira gain?",
        "options": {
          "A": "₦700,000",
          "B": "₦725,000",
          "C": "₦750,000",
          "D": "₦775,000"
        },
